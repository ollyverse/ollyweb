---
import { useText } from '../i18n/ui';

const T = useText(Astro.currentLocale).footer;
const year = new Date().getFullYear();
---
<footer>
  <b>OLLYVERSE.COM</b><br />
  {T.teaser}<br />
  © {year} · {T.harmed}
</footer>

<style>
  footer { text-align: center; padding: 2.5rem 1rem 3.5rem; font-family: var(--pixel); font-size: 0.75rem; color: var(--muted); line-height: 2.2; }
  b { color: var(--butter); font-weight: 400; }
</style>
