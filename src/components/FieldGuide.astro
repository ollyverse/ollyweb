---
const cards = [
  { icon: '🐕', title: 'POPULATION', text: '1 good boy. Several squirrels (unconfirmed).', accent: 'var(--pink)', tilt: -2 },
  { icon: '🦴', title: 'CURRENCY', text: 'Bones. Exchange rate: 1 bone = 1 bone. Very stable.', accent: 'var(--cyan)', tilt: 1.5 },
  { icon: '🪐', title: 'LAWS OF PHYSICS', text: 'Gravity is optional within 3 meters of a snack.', accent: 'var(--lime)', tilt: -1 },
  { icon: '🧹', title: 'THREAT LEVEL', text: "The vacuum cleaner. We don't talk about the vacuum cleaner.", accent: 'var(--gold)', tilt: 2 },
];
---
<section class="lore">
  <h2 class="section-title">FIELD GUIDE TO THE OLLYVERSE</h2>
  <p class="section-sub">Required reading for all visiting humans.</p>
  <div class="cards">
    {cards.map(c => (
      <div class="card" style={`--accent:${c.accent};--tilt:${c.tilt}deg`}>
        <span class="icon">{c.icon}</span>
        <h4>{c.title}</h4>
        <p>{c.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .lore { max-width: 980px; margin: 0 auto; padding: 60px 16px 40px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px; }
  .card {
    background: var(--panel); border: 3px solid var(--ink); padding: 18px;
    transform: rotate(var(--tilt)); box-shadow: 6px 6px 0 var(--accent); transition: transform .2s;
  }
  .card:hover { transform: rotate(0) scale(1.04); }
  h4 { font-family: var(--pixel); font-size: 11px; color: var(--gold); margin: 0 0 12px; }
  p { margin: 0; line-height: 1.5; color: var(--muted); }
  .icon { font-size: 34px; display: block; margin-bottom: 8px; }
</style>
