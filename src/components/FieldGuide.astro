---
import { useText } from '../i18n/ui';

const T = useText(Astro.currentLocale).guide;
const accents = [
  { accent: 'var(--pink)', tilt: -2 },
  { accent: 'var(--lilac)', tilt: 1.5 },
  { accent: 'var(--mint)', tilt: -1 },
  { accent: 'var(--butter)', tilt: 2 },
];
const cards = T.cards.map((card, i) => ({ ...card, ...accents[i % accents.length] }));
---
<section class="lore">
  <h2 class="section-title">{T.title}</h2>
  <p class="section-sub">{T.sub}</p>
  <div class="cards">
    {cards.map(c => (
      <div class="card" style={`--accent:${c.accent};--tilt:${c.tilt}deg`}>
        <span class="icon">{c.icon}</span>
        <h4>{c.title}</h4>
        <p>{c.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .lore { max-width: 61.25rem; margin: 0 auto; padding: 3.75rem 1rem 2.5rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(13.125rem, 1fr)); gap: 1.125rem; }
  .card {
    background: var(--panel); border: 0.1875rem solid var(--ink); padding: 1.125rem;
    transform: rotate(var(--tilt)); box-shadow: 0.375rem 0.375rem 0 var(--accent); transition: transform .2s;
  }
  .card:hover { transform: rotate(0) scale(1.04); }
  h4 { font-family: var(--pixel); font-size: 0.8125rem; color: var(--butter); margin: 0 0 0.75rem; }
  p { margin: 0; line-height: 1.5; color: var(--muted); }
  .icon { font-size: 2.125rem; display: block; margin-bottom: 0.5rem; }
</style>
