---
const letters = [...'OLLYVERSE'];
---
<section class="hero">
  <div>
    <div class="kicker">✦ WELCOME TO THE ✦</div>
    <h1 aria-label="Ollyverse">{letters.map(l => <span class="l">{l}</span>)}</h1>
    <p class="sub">A tiny universe run by <b>one very good boy</b>.<br />He lost his bone. Again. Somewhere between planets.</p>

    <div class="olly-stage" id="hero-olly" title="Boop the dog">
      <div class="bubble" id="hero-bubble">WOOF!</div>
      <canvas id="hero-canvas" width="120" height="100"></canvas>
    </div>

    <a class="cta" href="#play">▶ PRESS START</a>
    <span class="tiny">(psst — boop Olly first)</span>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - 60px);
    display: grid; place-items: center; text-align: center;
    padding: 24px 16px 48px;
  }
  .kicker { font-family: var(--pixel); font-size: 11px; color: var(--cyan); letter-spacing: 3px; }
  h1 {
    font-family: "Bungee Shade", var(--display); font-weight: 400;
    font-size: clamp(34px, 10vw, 140px); line-height: .95; margin: 18px 0 8px;
    color: var(--gold);
    text-shadow: 0 0 30px rgba(255, 79, 163, .45);
  }
  .l { display: inline-block; animation: bob 2.4s ease-in-out infinite; }
  .l:nth-child(even) { color: var(--pink); }
  @keyframes bob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-10px) rotate(3deg); } }
  .sub { max-width: 540px; margin: 0 auto; font-size: clamp(16px, 2.2vw, 20px); color: var(--muted); line-height: 1.5; }
  .sub b { color: var(--ink); }

  .olly-stage { position: relative; width: 216px; margin: 28px auto 8px; cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
  .olly-stage canvas { width: 216px; height: 180px; image-rendering: pixelated; display: block; animation: hover 3s ease-in-out infinite; }
  .olly-stage::after { /* planet under Olly */
    content: ""; position: absolute; left: 50%; bottom: -22px; width: 300px; height: 44px; transform: translateX(-50%);
    background: radial-gradient(ellipse at center, #6b3bd6 0%, #3b1d86 55%, transparent 72%); z-index: -1;
  }
  @keyframes hover { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .bubble {
    position: absolute; top: -18px; right: -70px; font-family: var(--pixel); font-size: 12px;
    background: var(--ink); color: var(--bg); padding: 10px 12px; opacity: 0; transform: scale(.6) rotate(-6deg);
    transition: opacity .15s, transform .15s; pointer-events: none; white-space: nowrap;
  }
  .bubble::after { content: ""; position: absolute; left: 10px; bottom: -8px; border: 8px solid transparent; border-top-color: var(--ink); border-bottom: 0; }
  .bubble.show { opacity: 1; transform: scale(1) rotate(-6deg); }

  .cta {
    display: inline-block; margin-top: 36px; font-family: var(--pixel); font-size: 14px; letter-spacing: 1px;
    color: var(--bg); background: var(--lime); padding: 18px 26px; text-decoration: none;
    box-shadow: 6px 6px 0 var(--pink); animation: blink 1.1s steps(2) infinite;
  }
  .cta:hover { animation: none; }
  .cta:active { transform: translate(4px, 4px); box-shadow: 2px 2px 0 var(--pink); }
  @keyframes blink { 50% { filter: brightness(1.25); } }
  .tiny { display: block; margin-top: 14px; font-size: 13px; color: var(--muted); opacity: .7; }

  @media (prefers-reduced-motion: reduce) {
    .l, .olly-stage canvas, .cta { animation: none; }
  }
</style>

<script>
  import { drawOlly } from '../lib/sprites';
  import { sfx } from '../lib/sound';

  const WORDS = ['WOOF!', 'BORK!', 'BONE??', 'HI HUMAN', 'AWOOO!', 'SNACK?', '*sniff*'];
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const bubble = document.getElementById('hero-bubble')!;
  let wag = 0, excited = 0, hideTimer = 0;

  setInterval(() => {
    // lazy wag at rest, frantic wag + happy dance after a boop
    if (excited > 0 || Math.random() < 0.6) wag ^= 1;
    excited = Math.max(0, excited - 1);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawOlly(ctx, 0, 0, 10, { wag, step: excited ? wag : 0 });
  }, 180);

  document.getElementById('hero-olly')!.addEventListener('click', () => {
    sfx.woof();
    bubble.textContent = WORDS[(Math.random() * WORDS.length) | 0];
    bubble.classList.add('show');
    excited = 12;
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => bubble.classList.remove('show'), 900);
  });
</script>
