---
import { useText } from '../i18n/ui';

const T = useText(Astro.currentLocale).hero;
const letters = [...'OLLYVERSE'];
---
<section class="hero">
  <div>
    <div class="kicker">{T.kicker}</div>
    <h1 aria-label="Ollyverse">{letters.map(l => <span class="l">{l}</span>)}</h1>
    <p class="sub" set:html={T.sub} />

    <div class="olly-stage" id="hero-olly" title={T.boop}>
      <div class="bubble" id="hero-bubble">{T.barks[0]}</div>
      <canvas id="hero-canvas" width="180" height="130"></canvas>
    </div>

    <a class="cta" href="#play">{T.cta}</a>
    <span class="tiny">{T.tiny}</span>
  </div>
</section>

<style>
  .hero {
    display: grid; place-items: center; text-align: center;
    padding: 1rem 1rem 1.5rem;
  }
  .kicker { font-family: var(--pixel); font-size: 0.6875rem; color: var(--lilac); letter-spacing: 0.1875rem; }
  h1 {
    font-family: "Bungee Shade", var(--display); font-weight: 400;
    font-size: clamp(2.125rem, 10vw, 8.75rem); line-height: .95; margin: 1.125rem 0 0.5rem;
    color: var(--butter);
    text-shadow: 0 0 1.875rem rgba(255, 143, 207, .45);
  }
  .l { display: inline-block; animation: bob 2.4s ease-in-out infinite; }
  .l:nth-child(even) { color: var(--pink); }
  @keyframes bob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-0.625rem) rotate(3deg); } }
  .sub { max-width: 33.75rem; margin: 0 auto; font-size: clamp(1rem, 2.2vw, 1.25rem); color: var(--muted); line-height: 1.5; }
  .sub :global(b) { color: var(--ink); }

  .olly-stage { position: relative; width: 18rem; margin: 1.75rem auto 0.5rem; cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
  .olly-stage canvas { width: 18rem; height: 13rem; image-rendering: pixelated; display: block; animation: hover 3s ease-in-out infinite; }
  .olly-stage::after { /* planet under Olly */
    content: ""; position: absolute; left: 50%; bottom: -1.375rem; width: 18.75rem; height: 2.75rem; transform: translateX(-50%);
    background: radial-gradient(ellipse at center, #b98cff 0%, #6a47b8 55%, transparent 72%); z-index: -1;
  }
  @keyframes hover { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-0.5rem); } }
  .bubble {
    position: absolute; top: -1.125rem; right: -2.5rem; font-family: var(--pixel); font-size: 0.75rem;
    background: var(--ink); color: var(--bg); padding: 0.625rem 0.75rem; opacity: 0; transform: scale(.6) rotate(-6deg);
    transition: opacity .15s, transform .15s; pointer-events: none; white-space: nowrap;
  }
  .bubble::after { content: ""; position: absolute; left: 0.625rem; bottom: -0.5rem; border: 0.5rem solid transparent; border-top-color: var(--ink); border-bottom: 0; }
  .bubble.show { opacity: 1; transform: scale(1) rotate(-6deg); }

  .cta {
    display: inline-block; margin-top: 2.25rem; font-family: var(--pixel); font-size: 0.875rem; letter-spacing: 0.0625rem;
    color: var(--bg); background: var(--mint); padding: 1.125rem 1.625rem; text-decoration: none;
    box-shadow: 0.375rem 0.375rem 0 var(--pink); animation: blink 1.1s steps(2) infinite;
  }
  .cta:hover { animation: none; }
  .cta:active { transform: translate(0.25rem, 0.25rem); box-shadow: 0.125rem 0.125rem 0 var(--pink); }
  @keyframes blink { 50% { filter: brightness(1.25); } }
  .tiny { display: block; margin-top: 0.875rem; font-size: 0.8125rem; color: var(--muted); opacity: .7; }

  /* side by side with the game (see pages/index.astro): the game is right there, no need to scroll */
  @media (min-width: 1100px) {
    h1 { font-size: min(5vw, 9rem); }
    .cta, .tiny { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .l, .olly-stage canvas, .cta { animation: none; }
  }
</style>

<script>
  import { drawOlly } from '../lib/sprites';
  import { sfx } from '../lib/sound';
  import { pageText } from '../i18n/ui';

  const WORDS = pageText().hero.barks;
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const bubble = document.getElementById('hero-bubble')!;
  let wag = 0, excited = 0, hideTimer = 0;

  setInterval(() => {
    // lazy wag at rest, frantic wag + happy dance after a boop, a blink now and then
    if (excited > 0 || Math.random() < 0.6) wag ^= 1;
    excited = Math.max(0, excited - 1);
    const blink = !excited && Math.random() < 0.06;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawOlly(ctx, 10, 10, 10, { wag, step: excited ? wag : 0, blink }); // 1px of room for the outline
  }, 180);

  document.getElementById('hero-olly')!.addEventListener('click', () => {
    sfx.woof();
    bubble.textContent = WORDS[(Math.random() * WORDS.length) | 0];
    bubble.classList.add('show');
    excited = 12;
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => bubble.classList.remove('show'), 900);
  });
</script>
