<header>
  <a class="logo" href="/#top">OLLY<span>VERSE</span></a>
  <button class="chip" id="mute" aria-label="Toggle sound">♪ ON</button>
</header>

<style>
  header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px clamp(16px, 4vw, 40px);
    font-family: var(--pixel); font-size: 11px; letter-spacing: 1px;
  }
  .logo { color: var(--gold); text-decoration: none; }
  .logo span { color: var(--pink); }
  .chip {
    font: inherit; color: var(--ink); background: transparent; cursor: pointer;
    border: 2px solid var(--muted); padding: 8px 10px;
    box-shadow: 3px 3px 0 var(--pink);
  }
  .chip:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--pink); }
</style>

<script>
  import { isMuted, setMuted } from '../lib/sound';

  const btn = document.getElementById('mute')!;
  const paint = () => { btn.textContent = isMuted() ? '♪ OFF' : '♪ ON'; };
  paint();
  btn.addEventListener('click', () => { setMuted(!isMuted()); paint(); });
</script>
