<header>
  <a class="logo" href="/#top">OLLY<span>VERSE</span></a>
  <button class="chip" id="mute" aria-label="Toggle sound">♪ ON</button>
</header>

<style>
  header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    font-family: var(--pixel); font-size: 0.8125rem; letter-spacing: 0.0625rem;
  }
  .logo { color: var(--butter); text-decoration: none; }
  .logo span { color: var(--pink); }
  .chip {
    font: inherit; color: var(--ink); background: transparent; cursor: pointer;
    border: 0.125rem solid var(--muted); padding: 0.5rem 0.625rem;
    box-shadow: 0.1875rem 0.1875rem 0 var(--pink);
  }
  .chip:active { transform: translate(0.125rem, 0.125rem); box-shadow: 0.0625rem 0.0625rem 0 var(--pink); }
</style>

<script>
  import { isMuted, setMuted } from '../lib/sound';

  const btn = document.getElementById('mute')!;
  const paint = () => { btn.textContent = isMuted() ? '♪ OFF' : '♪ ON'; };
  paint();
  btn.addEventListener('click', () => { setMuted(!isMuted()); paint(); });
</script>
