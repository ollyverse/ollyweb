---
import { useText } from '../i18n/ui';

const T = useText(Astro.currentLocale).game;
const dirs = [
  { dir: 'up', label: '▲' },
  { dir: 'left', label: '◀' },
  { dir: 'down', label: '▼' },
  { dir: 'right', label: '▶' },
];
---
<section class="game-wrap" id="play">
  <h2 class="section-title">{T.title}</h2>
  <p class="section-sub">{T.sub}</p>

  <div class="cabinet" data-maze-game>
    <div class="hud">
      <div><small>{T.hud.planet}</small><b data-ref="level">1</b></div>
      <div><small>{T.hud.lives}</small><b data-ref="lives" class="lives">♥♥♥</b></div>
      <div><small>{T.hud.bark}</small><b data-ref="bark">{T.hud.ready}</b><span class="meter bark" data-ref="bark-meter"></span></div>
      <div><small>{T.hud.sniff}</small><b data-ref="sniff">{T.hud.ready}</b><span class="meter" data-ref="sniff-meter"></span></div>
    </div>

    <div class="screen">
      <canvas data-ref="canvas"></canvas>
      <div class="overlay" data-ref="overlay">
        <h3 data-ref="overlay-title">{T.introTitle}</h3>
        <p data-ref="overlay-text" set:html={T.introText} />
        <button class="btn" data-ref="overlay-button">{T.introButton}</button>
      </div>
    </div>

    <div class="thought" data-ref="thought">{T.firstThought}</div>

    <div class="pad">
      {dirs.map(d => <button class={d.dir} data-dir={d.dir} aria-label={d.dir}>{d.label}</button>)}
      <button class="bark" data-bark>{T.barkButton}</button>
      <button class="sniff" data-sniff>{T.sniffButton}</button>
    </div>
    <div class="keys" set:html={T.keys} />
  </div>
</section>

<style>
  .game-wrap { padding: 1.5rem 1rem 2.5rem; }
  .cabinet {
    /* keep header, title and the whole cabinet (maze + HUD) inside one screen height */
    max-width: min(44rem, max(20rem, calc(100svh - 24rem))); margin: 0 auto; background: var(--panel); padding: 0.875rem;
    border: 0.25rem solid var(--ink); box-shadow: 0.5rem 0.5rem 0 var(--lilac), -0.5rem -0.5rem 0 var(--pink);
  }
  .hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.375rem; font-family: var(--pixel); font-size: 0.8125rem; margin-bottom: 0.625rem; }
  .hud div { background: var(--bg-deep); padding: 0.5rem 0.375rem; text-align: center; line-height: 1.7; }
  .hud small { display: block; color: var(--muted); font-size: 0.625rem; }
  .hud b { color: var(--butter); font-weight: 400; }
  .hud .lives { color: var(--pink); letter-spacing: 0.15em; }
  .meter.bark { background: var(--butter); }
  .meter { display: block; width: 100%; height: 0.25rem; background: var(--mint); margin-top: 0.25rem; transition: width .1s linear; }

  .screen { position: relative; aspect-ratio: 1; background: var(--bg-deep); }
  canvas { width: 100%; height: 100%; display: block; touch-action: none; image-rendering: pixelated; }
  .overlay {
    position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 0.875rem; padding: 1.25rem;
    background: rgba(10, 5, 24, .82); backdrop-filter: blur(0.125rem);
  }
  .overlay[hidden] { display: none; }
  h3 { font-family: var(--display); font-size: clamp(1.75rem, 7vw, 3rem); margin: 0; color: var(--butter); text-shadow: 0.1875rem 0.1875rem 0 var(--pink); }
  .overlay p { margin: 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.5; }
  /* overlay text is set via innerHTML, so its <b> tags don't carry the scope attribute */
  .overlay p :global(b) { color: var(--ink); }
  .thought { font-family: var(--pixel); font-size: 0.75rem; color: var(--mint); min-height: 1.875rem; margin: 0.75rem 0.25rem 0; line-height: 1.6; }
  .thought::before { content: "OLLY> "; color: var(--pink); }

  .pad { display: none; margin-top: 0.75rem; grid-template-columns: repeat(3, 4rem); grid-template-rows: repeat(2, 3.5rem); gap: 0.375rem; justify-content: center; }
  .pad button {
    font-family: var(--pixel); font-size: 1rem; color: var(--ink); background: var(--bg-deep); cursor: pointer;
    border: 0.1875rem solid var(--muted); touch-action: none; user-select: none; -webkit-user-select: none;
  }
  .pad button:active, .pad button.on { background: var(--pink); color: var(--bg); }
  .pad .up { grid-column: 2; grid-row: 1; }
  .pad .bark { grid-column: 1; grid-row: 1; font-size: 0.6875rem; color: var(--butter); border-color: var(--butter); }
  .pad .sniff { grid-column: 3; grid-row: 1; font-size: 0.6875rem; color: var(--mint); border-color: var(--mint); }
  .pad .left { grid-column: 1; grid-row: 2; }
  .pad .down { grid-column: 2; grid-row: 2; }
  .pad .right { grid-column: 3; grid-row: 2; }
  .keys { text-align: center; font-family: var(--pixel); font-size: 0.6875rem; color: var(--muted); margin-top: 0.875rem; line-height: 2; }
  .keys :global(kbd) { color: var(--bg); background: var(--muted); padding: 0.125rem 0.3125rem; font: inherit; }
  @media (pointer: coarse), (max-width: 700px) {
    .pad { display: grid; }
    .keys { display: none; }
  }
</style>

<script>
  import { mountMazeGame } from '../game/game';

  document.querySelectorAll<HTMLElement>('[data-maze-game]').forEach(mountMazeGame);
</script>
