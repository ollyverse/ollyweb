---
import { useText } from '../i18n/ui';

const T = useText(Astro.currentLocale).game;
const dirs = [
  { dir: 'up', label: '▲' },
  { dir: 'left', label: '◀' },
  { dir: 'down', label: '▼' },
  { dir: 'right', label: '▶' },
];
---
<section class="game-wrap" id="play">
  <h2 class="section-title">{T.title}</h2>
  <p class="section-sub">{T.sub}</p>

  <div class="cabinet" data-maze-game>
    <div class="hud">
      <div><small>{T.hud.planet}</small><b data-ref="level">1</b></div>
      <div><small>{T.hud.lives}</small><b data-ref="lives" class="lives">♥♥♥</b></div>
      <div><small>{T.hud.bark}</small><b data-ref="bark">{T.hud.ready}</b><span class="meter bark" data-ref="bark-meter"></span></div>
      <div><small>{T.hud.sniff}</small><b data-ref="sniff">{T.hud.ready}</b><span class="meter" data-ref="sniff-meter"></span></div>
    </div>

    <div class="screen">
      <canvas data-ref="canvas"></canvas>
      <div class="overlay" data-ref="overlay">
        <h3 data-ref="overlay-title">{T.introTitle}</h3>
        <p data-ref="overlay-text" set:html={T.introText} />
        <div class="abilities" data-ref="abilities">
          <div class="ability special">
            <span class="tag">{T.abilities.special}</span>
            <span class="name">{T.abilities.bark}</span>
            <span class="desc">{T.abilities.barkText}</span>
            <span class="how"><kbd class="keyboard">{T.abilities.barkKeys}</kbd><kbd class="touch">{T.abilities.barkTouch}</kbd></span>
          </div>
          <div class="ability">
            <span class="name">{T.abilities.sniff}</span>
            <span class="desc">{T.abilities.sniffText}</span>
            <span class="how"><kbd class="keyboard">{T.abilities.sniffKeys}</kbd><kbd class="touch">{T.abilities.sniffTouch}</kbd></span>
          </div>
        </div>
        <button class="btn" data-ref="overlay-button">{T.introButton}</button>
      </div>
    </div>

    <div class="thought" data-ref="thought">{T.firstThought}</div>

    <div class="pad">
      <div class="dpad">
        {dirs.map(d => <button class={d.dir} data-dir={d.dir} aria-label={d.dir}>{d.label}</button>)}
      </div>
      <div class="actions">
        <button class="bark" data-bark>{T.barkButton}</button>
        <button class="sniff" data-sniff>{T.sniffButton}</button>
      </div>
    </div>
    <div class="keys" set:html={T.keys} />
  </div>
</section>

<style>
  .game-wrap { padding: 1.5rem 1rem 2.5rem; }
  .cabinet {
    /* keep header, title and the whole cabinet (maze + HUD) inside one screen height */
    max-width: min(44rem, max(20rem, calc(100svh - 24rem))); margin: 0 auto; background: var(--panel); padding: 0.875rem;
    border: 0.25rem solid var(--ink); box-shadow: 0.5rem 0.5rem 0 var(--lilac), -0.5rem -0.5rem 0 var(--pink);
  }
  /* while playing, touches on the cabinet steer Olly instead of scrolling or zooming the page */
  .cabinet.playing { touch-action: none; overscroll-behavior: contain; }
  .hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.375rem; font-family: var(--pixel); font-size: 0.8125rem; margin-bottom: 0.625rem; }
  .hud div { background: var(--bg-deep); padding: 0.5rem 0.375rem; text-align: center; line-height: 1.7; }
  .hud small { display: block; color: var(--muted); font-size: 0.625rem; }
  .hud b { color: var(--butter); font-weight: 400; }
  .hud .lives { color: var(--pink); letter-spacing: 0.15em; }
  .meter.bark { background: var(--butter); }
  .meter { display: block; width: 100%; height: 0.25rem; background: var(--mint); margin-top: 0.25rem; transition: width .1s linear; }

  .screen { position: relative; aspect-ratio: 1; background: var(--bg-deep); }
  canvas { width: 100%; height: 100%; display: block; touch-action: none; image-rendering: pixelated; }
  .overlay {
    position: absolute; inset: 0; display: grid; place-content: safe center stretch; text-align: center; /* stretch: wrap text instead of overflowing */ gap: 0.875rem; padding: 1.25rem;
    overflow-y: auto; /* long win texts on small phones */
    background: rgba(10, 5, 24, .82); backdrop-filter: blur(0.125rem);
  }
  .overlay[hidden] { display: none; }
  h3 { font-family: var(--display); font-size: clamp(1.75rem, 7vw, 3rem); margin: 0; color: var(--butter); text-shadow: 0.1875rem 0.1875rem 0 var(--pink); }
  .overlay p { margin: 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.5; }
  /* overlay text is set via innerHTML, so its <b> tags don't carry the scope attribute */
  .overlay p :global(b) { color: var(--ink); }

  /* intro: the bark is the star, sniff is the sidekick */
  .abilities { display: grid; gap: 0.5rem; max-width: 26rem; margin: 0 auto; text-align: left; }
  .abilities[hidden] { display: none; }
  .ability { display: grid; grid-template-columns: 1fr auto; gap: 0.125rem 0.75rem; align-items: center; padding: 0.5rem 0.75rem; border: 0.125rem solid var(--mint); background: rgba(15, 10, 34, .85); }
  .ability .name { font-family: var(--pixel); font-size: 0.75rem; color: var(--mint); }
  .ability .desc { grid-column: 1; font-size: 0.875rem; color: var(--muted); line-height: 1.35; }
  .ability .how { grid-column: 2; grid-row: 1 / span 2; }
  .ability kbd { font-family: var(--pixel); font-size: 0.5625rem; color: var(--bg); background: var(--mint); padding: 0.25rem 0.375rem; white-space: nowrap; }
  .ability.special { border-color: var(--butter); box-shadow: 0.25rem 0.25rem 0 var(--pink); padding-top: 0.75rem; position: relative; }
  .ability.special .name { color: var(--butter); font-size: 1rem; animation: haf 1.2s steps(2) infinite; }
  .ability.special kbd { background: var(--butter); }
  .ability .tag {
    position: absolute; top: -0.625rem; left: 0.625rem; font-family: var(--pixel); font-size: 0.5625rem;
    color: var(--bg); background: var(--pink); padding: 0.1875rem 0.375rem;
  }
  @keyframes haf { 50% { transform: translateX(0.125rem) rotate(-2deg); } }
  .touch { display: none; }
  @media (pointer: coarse) {
    .keyboard { display: none; }
    .touch { display: inline; }
  }
  @media (max-height: 600px) and (pointer: coarse) {
    [data-ref="overlay-text"]:has(+ .abilities:not([hidden])) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .ability.special .name { animation: none; } }
  /* fixed two-line height, so a long line never pushes the controls around */
  .thought { font-family: var(--pixel); font-size: 0.75rem; color: var(--mint); height: 3.2em; overflow: hidden; margin: 0.75rem 0.25rem 0; line-height: 1.6; }
  .thought::before { content: "OLLY> "; color: var(--pink); }

  /* gamepad: d-pad on the left thumb, actions on the right */
  .pad { display: none; margin-top: 0.5rem; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .pad button {
    font-family: var(--pixel); font-size: 1.125rem; color: var(--ink); background: var(--bg-deep); cursor: pointer;
    border: 0.1875rem solid var(--muted); touch-action: none; user-select: none; -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none;
  }
  .pad button:active, .pad button.on { background: var(--pink); color: var(--bg); }
  .dpad { display: grid; grid-template-columns: repeat(3, 3.75rem); grid-template-rows: repeat(2, 3.5rem); gap: 0.3rem; }
  .dpad .up { grid-column: 2; grid-row: 1; }
  .dpad .left { grid-column: 1; grid-row: 2; }
  .dpad .down { grid-column: 2; grid-row: 2; }
  .dpad .right { grid-column: 3; grid-row: 2; }
  .actions { display: grid; grid-template-rows: repeat(2, 3.5rem); gap: 0.3rem; flex: 0 1 7rem; }
  .actions button { font-size: 0.875rem; }
  .actions .bark { color: var(--butter); border-color: var(--butter); }
  .actions .sniff { color: var(--mint); border-color: var(--mint); }
  .keys { text-align: center; font-family: var(--pixel); font-size: 0.6875rem; color: var(--muted); margin-top: 0.875rem; line-height: 2; }
  .keys :global(kbd) { color: var(--bg); background: var(--muted); padding: 0.125rem 0.3125rem; font: inherit; }
  @media (pointer: coarse), (max-width: 700px) {
    .pad { display: flex; }
    .keys { display: none; }
    .game-wrap { padding-inline: 0.75rem; }
    .cabinet { padding: 0.625rem; }
    /* phones: the cabinet (HUD + maze + thought + controls) fits one screen on its own */
    .cabinet { max-width: min(100%, max(16rem, calc(100svh - 16.5rem))); }
    .overlay { padding: 0.75rem; gap: 0.625rem; }
    .overlay p { font-size: 0.9375rem; }
    .ability.special { grid-template-columns: 1fr; }
    .ability.special .how { grid-column: 1; grid-row: auto; margin-top: 0.25rem; }
    /* sniff shrinks to one line: name + button */
    .ability:not(.special) .desc { display: none; }
    .ability:not(.special) .how { grid-row: 1; }
  }
  /* phones held sideways: maze on the left, everything else on the right */
  @media (orientation: landscape) and (max-height: 540px) {
    .cabinet {
      max-width: none; width: fit-content; display: grid; gap: 0 1rem; align-items: start;
      grid-template-columns: auto 19rem; grid-template-areas: "screen hud" "screen thought" "screen pad";
    }
    .screen { grid-area: screen; width: calc(100svh - 2.5rem); }
    .hud { grid-area: hud; grid-template-columns: repeat(2, 1fr); }
    .thought { grid-area: thought; }
    .pad { grid-area: pad; }
  }
</style>

<script>
  import { mountMazeGame } from '../game/game';

  document.querySelectorAll<HTMLElement>('[data-maze-game]').forEach(mountMazeGame);
</script>
